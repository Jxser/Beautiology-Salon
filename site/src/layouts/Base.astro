---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { salon } from '../data/salon';

interface Props {
  title?: string;
  description?: string;
  hideMobileBar?: boolean;
}

const {
  title,
  description = 'Beautiology Salon in Henderson, NV, offers haircuts, color, balayage, blonding and color correction, led by master colorist Tracey La. Book online.',
  hideMobileBar = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${salon.name}` : `${salon.name} · Hair Color & Cuts in Henderson, NV`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: salon.name,
  url: Astro.site?.toString(),
  telephone: salon.phone,
  email: salon.email,
  image: new URL('/logo-mark.png', Astro.site).toString(),
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: salon.address.street,
    addressLocality: salon.address.city,
    addressRegion: salon.address.region,
    postalCode: salon.address.zip,
    addressCountry: 'US',
  },
  openingHours: 'Mo-Su 09:00-18:00',
  sameAs: [salon.instagram, salon.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo-mark.png" />
    <meta name="theme-color" content="#5f2d8f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/cut.jpg', Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500&family=Josefin+Sans:wght@300;400;600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {!hideMobileBar && (
      <div class="mobile-bar">
        <a class="btn btn--ghost btn--sm" href={salon.phoneHref}>Call</a>
        <a class="btn btn--sm" href="/book">Book now</a>
      </div>
    )}

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      // Never leave content hidden if the observer doesn't fire (old browsers, background tabs).
      setTimeout(() => document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in')), 2500);
    </script>
  </body>
</html>

<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 40;
    display: none; gap: 10px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: rgb(250 247 243 / 0.92); backdrop-filter: blur(12px);
    border-top: 1px solid var(--line);
  }
  .mobile-bar .btn { flex: 1; }
  .mobile-bar .btn--ghost { flex: 0 0 34%; }
  @media (max-width: 760px) {
    .mobile-bar { display: flex; }
    :global(body) { padding-bottom: 72px; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { salon, team } from '../data/salon';

const values = [
  { t: 'Consultation first', d: 'Every appointment begins with a conversation about your hair goals, lifestyle and maintenance preferences.' },
  { t: 'Professional products', d: 'We use professional color lines including Wella, Paul Mitchell, Kenra, Goldwell and Redken, with ammonia-free options available.' },
  { t: 'Ongoing education', d: 'Our stylists train regularly in current techniques and trends.' },
];
---

<Base title="About Us" description="Beautiology Salon is a full-service hair salon in Henderson, NV, owned by stylists Tracey La and Lupita Pandula, who bring more than 40 years of combined experience.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About us</span>
      <h1 class="display">About <em>Beautiology</em></h1>
      <p class="lede">Beautiology is our flagship salon in Henderson’s Anthem Village and the original location in our family of salons.</p>
    </div>
  </section>

  <section class="wrap story">
    <img src="/images/shampoo.jpg" alt="Client relaxing during a shampoo" width="1024" height="1024" loading="lazy" data-reveal />
    <div data-reveal>
      <p class="quote">“Our goal is a welcoming, comfortable salon where every client receives exceptional service and leaves feeling confident.”</p>
      <p class="quote__by">{salon.owners}, Co-owners</p>
      <p>We offer precision cuts, dimensional color, balayage, blonding, restorative treatments and full color transformations in a relaxed, welcoming setting.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="values">
        {values.map((v) => (
          <div data-reveal>
            <h2>{v.t}</h2>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section team-wrap">
    <div class="wrap">
      <span class="eyebrow">Our team</span>
      <h2 class="h2">Our <em>stylists</em></h2>
      <div class="people">
        {team.map((m) => (
          <article class="person" data-reveal>
            <div class="person__avatar" aria-hidden="true">{m.name.split(' ').map((p) => p[0]).join('')}</div>
            <h3>{m.name}</h3>
            <p class="person__role">{m.role}</p>
            <p>{m.bio}</p>
          </article>
        ))}
      </div>
      <a class="btn" href="/book">Book with our team</a>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-block: clamp(48px, 7vw, 96px) 56px; }
  .page-hero .display { margin: 18px 0 20px; max-width: 16ch; }

  .story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .story img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--radius); }
  .quote { font-family: var(--font-serif); font-style: italic; font-size: clamp(24px, 2.6vw, 32px); line-height: 1.3; color: var(--purple-ink); }
  .quote__by { margin: 14px 0 28px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--purple); }
  .story p:last-child { color: var(--ink-2); }

  .values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .values > div { padding: 32px; border-top: 2px solid var(--purple); background: var(--white); border-radius: 0 0 var(--radius) var(--radius); }
  .values h2 { font-size: 22px; font-weight: 400; margin-bottom: 10px; }
  .values p { color: var(--muted); font-size: 15.5px; }

  .team-wrap { background: var(--lilac); }
  .team-wrap .h2 { margin: 16px 0 40px; }
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; margin-bottom: 40px; }
  .person { padding: 32px; border-radius: var(--radius); background: var(--white); }
  .person__avatar {
    width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; padding-top: 4px;
    background: var(--purple); color: var(--white); font-size: 22px; letter-spacing: .08em; margin-bottom: 20px;
  }
  .person h3 { font-size: 24px; font-weight: 400; }
  .person__role { font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--purple); margin: 6px 0 14px; }
  .person p:last-child { color: var(--muted); font-size: 15.5px; }

  @media (max-width: 1024px) { .story { gap: 40px; } .values > div, .person { padding: 26px; } }
  @media (max-width: 760px) {
    .story, .values { grid-template-columns: 1fr; }
    .story { gap: 28px; }
    .story img { aspect-ratio: 3 / 2; }
    .page-hero { padding-bottom: 36px; }
  }
</style>

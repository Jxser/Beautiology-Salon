---
import CrystalBase from '../../layouts/CrystalBase.astro';
import { crystal, crystalMenu, formatCrystalPrice } from '../../data/crystal';
---

<CrystalBase title="Services & Prices" description="Service menu and pricing for Crystal Salon & Headspa in Henderson, NV, including head spa treatments, haircuts, color, blonding, extensions, and lash and brow services.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Service menu</span>
      <h1 class="display">Services and <em>pricing</em></h1>
      <p class="lede">Listed prices are starting prices and may vary with hair length and density. Your stylist will confirm the final price during your consultation, before any work begins.</p>
    </div>
  </section>

  <nav class="cats" aria-label="Service categories">
    <div class="wrap cats__inner">
      {crystalMenu.map((c) => <a href={`#${c.slug}`}>{c.name}</a>)}
    </div>
  </nav>

  <div class="wrap menu">
    {crystalMenu.map((c) => (
      <section class="cat" id={c.slug}>
        <header class="cat__head">
          <h2>{c.name}</h2>
          <p>{c.blurb}</p>
        </header>
        <ul class="rows">
          {c.services.map((s) => (
            <li class="row">
              <div class="row__name">
                <span>{s.name}{s.minutes && <span class="row__mins"> · {s.minutes} min</span>}</span>
                {s.note && <small>{s.note}</small>}
                {s.consult && <small class="row__flag">Consultation recommended</small>}
              </div>
              <span class="row__dots" aria-hidden="true"></span>
              <span class="row__price">{formatCrystalPrice(s)}</span>
              <a class="btn btn--sm btn--ghost row__book" href={`/crystal/book?s=${s.fullslateId}`} aria-label={`Book ${s.name}`}>Book</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <aside class="note">
      <div>
        <h2>Not sure which service to book?</h2>
        <p>Book a free consultation or call us at <a href={crystal.phoneHref}>{crystal.phone}</a>. Online bookings require a {crystal.depositPercent}% deposit.</p>
      </div>
      <a class="btn btn--light" href="/crystal/book">Book an appointment</a>
    </aside>
  </div>
</CrystalBase>

<style>
  .page-hero { padding-block: clamp(44px, 6vw, 88px) 36px; }
  .page-hero .display { margin: 18px 0 18px; }

  .cats { position: sticky; top: 80px; z-index: 30; background: rgb(245 244 238 / .94); backdrop-filter: blur(12px); border-block: 1px solid var(--line); }
  .cats__inner { display: flex; gap: 8px; overflow-x: auto; padding-block: 12px; scrollbar-width: none; }
  .cats__inner::-webkit-scrollbar { display: none; }
  .cats a {
    flex: none; padding: 9px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--white);
    text-decoration: none; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap;
  }
  .cats a:hover { border-color: var(--purple); color: var(--purple); }

  .menu { padding-block: 52px 96px; display: grid; gap: 24px; }
  .cat { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px; padding: 38px; background: var(--white); border-radius: var(--radius); border: 1px solid var(--line); scroll-margin-top: 160px; }
  .cat__head h2 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(26px, 3vw, 34px); }
  .cat__head p { margin-top: 12px; color: var(--muted); font-size: 15.5px; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 14px; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .row:first-child { padding-top: 0; }
  .row:last-child { border-bottom: 0; padding-bottom: 0; }
  .row__name { display: grid; gap: 2px; }
  .row__name small { color: var(--muted); font-size: 13.5px; }
  .row__mins { color: var(--muted); }
  .row__flag { color: var(--accent) !important; }
  .row__dots { border-bottom: 1px dotted var(--lilac-2); height: 1px; margin-top: 4px; }
  .row__price { color: var(--accent); font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .row__book { min-height: 36px; padding: 10px 16px; }

  .note {
    display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap;
    padding: 38px; border-radius: var(--radius); background: var(--purple); color: var(--white);
  }
  .note h2 { font-family: var(--font-serif); font-weight: 400; font-size: 28px; }
  .note p { margin-top: 8px; color: rgb(255 255 255 / .82); max-width: 60ch; }
  .note a:not(.btn) { color: var(--white); }

  @media (max-width: 860px) { .cat { grid-template-columns: 1fr; gap: 22px; padding: 26px 22px; } }
  @media (max-width: 760px) { .cats { top: 68px; } }
  @media (max-width: 520px) {
    .row { grid-template-columns: 1fr auto; row-gap: 8px; }
    .row__dots { display: none; }
    .row__book { grid-column: 1 / -1; justify-self: start; min-height: 0; padding: 0; border: 0; background: none; color: var(--purple); font-size: 12px; }
    .row__book::after { content: ' →'; }
    .row__book:hover { background: none; text-decoration: underline; }
  }
</style>
